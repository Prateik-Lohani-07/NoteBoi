{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": true,
    "importHelpers": false,
    "isolatedModules": true,
    "lib": ["DOM", "ES2021"],
    "types": ["node"]
  },
  "include": ["main.ts", "src/**/*.ts"]
}
